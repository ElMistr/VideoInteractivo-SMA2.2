  m_Name: 1
  m_EditorClassIdentifier: 
  sentences:
  - text: "Mateo entra apresurado, sudando, mirando el celular. Respiraci\xF3n agitada
      Pasos r\xE1pidos"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 400, y: 0}
      moveSpeed: 0
    music: {fileID: 8300000, guid: c90bbda81fc61b64096dab173e188461, type: 3}
    sound: {fileID: 0}
  - text: Que cansancio !
    speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
    actions: []
    music: {fileID: 8300000, guid: c90bbda81fc61b64096dab173e188461, type: 3}
    sound: {fileID: 0}
  - text: "Mateo, \xBFtodo bien? Pareces como si\Lhubieras corrido una marat\xF3n."
    speaker: {fileID: 11400000, guid: e3fc034d25dd3aa4aac44f9597acd0e2, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
      spriteIndex: 0
      actionType: 3
      coords: {x: 0, y: 0}
      moveSpeed: 0
    music: {fileID: 8300000, guid: c90bbda81fc61b64096dab173e188461, type: 3}
    sound: {fileID: 0}
  - text: "Mis pap\xE1s no paran de llamarme\u2026 \Ldicen que tengo que decidir
      ya qu\xE9 voy a estudiar."
    speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
      spriteIndex: 0
      actionType: 3
      coords: {x: 0, y: 0}
      moveSpeed: 0
    music: {fileID: 8300000, guid: c90bbda81fc61b64096dab173e188461, type: 3}
    sound: {fileID: 0}
  - text: "A m\xED me pasa igual\u2026 mis pap\xE1s creen \Lque uno decide eso de
      un d\xEDa para otro."
    speaker: {fileID: 11400000, guid: 77306bc68283f8b4db77e9b7c2d43197, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
      spriteIndex: 0
      actionType: 3
      coords: {x: 0, y: 0}
      moveSpeed: 0
    music: {fileID: 8300000, guid: c90bbda81fc61b64096dab173e188461, type: 3}
    sound: {fileID: 0}
  - text: "Eso s\xED es presi\xF3n\u2026"
    speaker: {fileID: 11400000, guid: e3fc034d25dd3aa4aac44f9597acd0e2, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
      spriteIndex: 0
      actionType: 3
      coords: {x: 0, y: 0}
      moveSpeed: 0
    music: {fileID: 8300000, guid: c90bbda81fc61b64096dab173e188461, type: 3}
    sound: {fileID: 0}
  - text: Bastante
    speaker: {fileID: 11400000, guid: 77306bc68283f8b4db77e9b7c2d43197, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
      spriteIndex: 0
      actionType: 3
      coords: {x: 0, y: 0}
      moveSpeed: 0
    music: {fileID: 8300000, guid: c90bbda81fc61b64096dab173e188461, type: 3}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: fa238270389c60246a66b9da7631e9a6, type: 3}
